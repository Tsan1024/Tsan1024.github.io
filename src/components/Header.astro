---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</div>
	</nav>
</header>

<style>
	header { border-bottom: 1px solid var(--border); }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2rem, var(--content-width));
		margin: 0 auto;
		padding: 1.25rem 0;
	}
	.site-title { color: var(--text); font-weight: 700; text-decoration: none; }
	.links { display: flex; gap: 1.15rem; font-size: 0.92rem; }
	.links :global(a) { color: var(--muted); text-decoration: none; }
	.links :global(a:hover) { color: var(--text); }
	@media (max-width: 520px) {
		nav { align-items: flex-start; gap: 0.75rem; flex-direction: column; }
		.links { gap: 1rem; }
	}
</style>
