---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} home`}>{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/archive/">Archive</HeaderLink>
			<HeaderLink href="/bookmarks/">Bookmarks</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</div>
	</nav>
</header>

<style>
	header { border: 0; }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(calc(100% - 3rem), var(--wide-width));
		margin: 0 auto;
		padding: 2.25rem 0 0;
	}
	.site-title { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--text); font-weight: 700; letter-spacing: -0.02em; text-decoration: none; }
	.links { display: flex; gap: 1.15rem; font-size: 0.85rem; }
	.links :global(a) { color: var(--muted); text-decoration: none; }
	.links :global(a:hover) { color: var(--text); }
	@media (max-width: 520px) {
		nav { flex-wrap: wrap; gap: 0.8rem 1.25rem; padding-top: 1.5rem; }
		.site-title { font-size: 1rem; }
		.links { min-width: 0; flex-wrap: wrap; gap: 0.6rem 0.85rem; font-size: 0.8rem; }
		.links > :global(a:last-child) { display: none; }
	}
</style>
