---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<a class="site-title" href="/" aria-label={`${SITE_TITLE} 首页`}><span>T</span>{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/archive/">Archive</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</div>
	</nav>
</header>

<style>
	header { border-bottom: 1px solid color-mix(in srgb, var(--border) 78%, transparent); }
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2.5rem, var(--wide-width));
		margin: 0 auto;
		padding: 1.25rem 0;
	}
	.site-title { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--text); font-weight: 700; letter-spacing: -0.02em; text-decoration: none; }
	.site-title span { display: grid; place-items: center; width: 1.85rem; height: 1.85rem; border-radius: 50%; background: var(--accent); color: var(--background); font-family: ui-serif, Georgia, serif; font-size: 0.95rem; }
	.links { display: flex; gap: 1.15rem; font-size: 0.92rem; }
	.links :global(a) { color: var(--muted); text-decoration: none; }
	.links :global(a:hover) { color: var(--text); }
	@media (max-width: 520px) {
		nav { width: min(100% - 2rem, var(--wide-width)); }
		.site-title { gap: 0; font-size: 0; }
		.site-title span { font-size: 0.95rem; }
		.links { min-width: 0; justify-content: flex-end; gap: 1.05rem; font-size: 0.86rem; white-space: nowrap; }
		.links > :global(a:last-child) { display: none; }
	}
</style>
