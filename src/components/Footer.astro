---
const year = new Date().getFullYear();
---

<footer>
	<p>© {year} Tsan1024</p>
	<p class="footer-note">保持好奇，持续构建。</p>
	<nav aria-label="页脚导航"><a href="/rss.xml">RSS</a><span>·</span><a href="https://github.com/Tsan1024">GitHub</a></nav>
</footer>

<style>
	footer {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.25rem 1rem;
		width: min(100% - 2.5rem, var(--wide-width));
		margin: 4rem auto 0;
		padding: 1.5rem 0 3rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.88rem;
	}
	footer p { margin: 0; }
	.footer-note { color: var(--faint); }
	footer nav { grid-column: 2; grid-row: 1 / span 2; display: flex; align-items: center; gap: 0.5rem; }
	footer a { color: var(--muted); text-decoration: none; }
	footer a:hover { color: var(--text); }
	@media (max-width: 520px) {
		footer { grid-template-columns: 1fr; width: min(100% - 2rem, var(--wide-width)); }
		footer nav { grid-column: 1; grid-row: auto; margin-top: 0.65rem; }
	}
</style>
