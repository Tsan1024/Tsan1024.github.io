---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const products = (await getCollection('products', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={`Products · ${SITE_TITLE}`} description="Products, tools, and experiments I've built." /></head>
	<body>
		<Header />
		<main>
			<header class="page-heading"><h1>Products</h1><p lang="en">Products, tools, and experiments I've built.</p></header>
			{products.length > 0 ? (
				<ul class="post-list">
					{products.map(({ id, data }) => (
						<li><article>
							<h2><a href={`/products/${id}/`}>{data.title}</a></h2>
							<p class="post-description" lang={data.descriptionEn ? 'en' : 'zh-CN'}>{data.descriptionEn ?? data.description}</p>
							{data.tags.length > 0 && <ul class="tag-list">{data.tags.map((tag) => <li>{tag}</li>)}</ul>}
						</article></li>
					))}
				</ul>
			) : <p class="empty-state">Product details are on the way.</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-list article { display: block; }
	.empty-state { margin: 0; padding: 2rem 0; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.95rem; }
</style>
