---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LibraryShelf from '../components/LibraryShelf.astro';

const entries = (await getCollection('bookmarks')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const books = await Promise.all(entries.map(async entry => ({ ...entry, ...await render(entry) })));
const topics = [...new Set(books.map(book => book.data.topic))];
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title="Bookmarks · Tsan1024" description="A little library of articles worth returning to, with a few thoughts of my own." /></head>
	<body>
		<Header />
		<main class="library-page">
			<header class="page-heading"><h1>Bookmarks</h1><p lang="en">A little library of things worth returning to.</p></header>
			<div class="library-toolbar">
				<p>{topics.length} {topics.length === 1 ? 'shelf' : 'shelves'} <span>·</span> {books.length} {books.length === 1 ? 'bookmark' : 'bookmarks'}</p>
				<div class="view-switch" role="group" aria-label="View" hidden><button type="button" data-view="library" aria-pressed="true">Library</button><button type="button" data-view="list" aria-pressed="false">List</button></div>
			</div>
			<div id="library-view">
				<p class="hint">点击书脊或书目，直接查看点评与原文。</p>
				<div class="shelves">
					{topics.map((topic, index) => {
						const shelfBooks = books.filter(book => book.data.topic === topic);
						return <div class="shelf-group"><div class="shelf-card">
							<div class="shelf-caption"><span class="shelf-number">{String(index + 1).padStart(2, '0')}</span><h2>{topic}</h2><span class="shelf-count">{shelfBooks.length} {shelfBooks.length === 1 ? 'bookmark' : 'bookmarks'}</span></div>
							{Array.from({length: Math.ceil(shelfBooks.length / 12)}, (_, row) => <LibraryShelf books={shelfBooks.slice(row * 12, (row + 1) * 12).map(book => ({id: book.id, title: book.data.title}))} index={`${index}-${row}`} shelfId={`shelf-${index}`} offset={row * 12} />)}
							<details class="shelf" name="library-shelves" id={`shelf-${index}`}>
							<summary class="shelf-summary"><span class="shelf-action"><span class="when-closed">Browse shelf</span><span class="when-open">Close shelf</span><span class="shelf-toggle" aria-hidden="true">+</span></span></summary>
							<div class="shelf-content">
								<div class="books">
									{shelfBooks.map(({ id, data, Content }, bookIndex) => <details class="book" name={`books-${index}`} id={`entry-${id}`}>
										<summary class="book-title"><span class="index-number">{String(bookIndex + 1).padStart(2, '0')}</span>{data.title}</summary>
										<div class="book-note" id={`book-${id}`} tabindex="-1"><p class="note-meta">{data.author} · {data.date.toISOString().slice(0, 10)}</p><div class="prose"><Content /></div><a class="source-link" href={data.url} target="_blank" rel="noopener noreferrer">阅读原文 ↗ <span class="sr-only">（在新标签页打开）</span></a><p class="source-domain">{new URL(data.url).hostname}</p></div>
									</details>)}
								</div>
							</div>
						</details></div><details class="catalogue"><summary><span class="catalogue-closed">展开书单</span><span class="catalogue-open">收起书单</span><span class="catalogue-count">{shelfBooks.length}</span></summary><ol class="shelf-index" aria-label={`${topic}书目`}>{shelfBooks.map(({id, data}, bookIndex) => <li><span class="index-number">{String(bookIndex + 1).padStart(2, '0')}</span><div><a href={`#book-${id}`} data-open-book={`entry-${id}`} data-open-shelf={`shelf-${index}`}>{data.title}</a><span class="index-author">{data.author}</span></div></li>)}</ol></details></div>;
					})}
				</div>
				{books.length === 0 && <p class="hint">暂无收藏。</p>}
			</div>
			<div id="list-view" hidden>
				{topics.map(topic => <section class="list-topic"><h2>{topic}</h2>{books.filter(book => book.data.topic === topic).map(({ data, Content }) => <article class="list-book"><h3><a href={data.url} target="_blank" rel="noopener noreferrer">{data.title} ↗</a></h3><p class="note-meta">{data.author} · {data.date.toISOString().slice(0, 10)}</p><div class="prose"><Content /></div><a class="source-link" href={data.url} target="_blank" rel="noopener noreferrer">阅读原文 ↗</a></article>)}</section>)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	document.querySelectorAll<HTMLElement | SVGElement>('[data-open-book]').forEach(link => {
		link.addEventListener('click', (event) => {
			const shelf = document.getElementById(link.dataset.openShelf || '');
			const book = document.getElementById(link.dataset.openBook || '');
			if (!(shelf instanceof HTMLDetailsElement) || !(book instanceof HTMLDetailsElement)) return;
			event.preventDefault();
			shelf.open = true;
			book.open = true;
			const note = book.querySelector<HTMLElement>('.book-note');
			note?.focus({preventScroll: true});
			note?.scrollIntoView({block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
		});
	});
	const controls = document.querySelector<HTMLElement>('.view-switch');
	const library = document.querySelector<HTMLElement>('#library-view');
	const list = document.querySelector<HTMLElement>('#list-view');
	if (controls && library && list) {
		controls.hidden = false;
		controls.querySelectorAll<HTMLButtonElement>('button').forEach(button => {
			button.addEventListener('click', () => {
				const isLibrary = button.dataset.view === 'library';
				library.hidden = !isLibrary;
				list.hidden = isLibrary;
				controls.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
			});
		});
	}
</script>

<style>
	.library-page {
		--wood-light: #e7dfd0; --wood-front: #cfc4af; --wood-mid: #d8cebd; --wood-dark: #b8ab95; --wood-back: #eee9de; --wood-seam: #a99a82; --metal: #a7956d;
		--book-cloth: #49695e; --book-highlight: #789086; --book-shadow: #293f36; --book-label: #3f5c51; --book-foil: #d6cba8;
	}
	.library-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
	.library-toolbar p { margin: 0; color: var(--muted); font-size: 0.78rem; }
	.library-toolbar p span { padding: 0 0.4rem; }
	.view-switch { display: flex; gap: 0.25rem; border: 1px solid var(--border); border-radius: 5px; padding: 3px; }
	[hidden] { display: none !important; }
	button { border: 0; font: inherit; cursor: pointer; }
	.view-switch button { padding: 0.3rem 0.65rem; font-size: 0.75rem; background: transparent; color: var(--muted); border-radius: 2px; }
	.view-switch button[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
	button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
	.hint { margin: 1rem 0 2rem; color: var(--muted); font-size: 0.82rem; }
	.shelves { display: grid; gap: 1.8rem; }
	.shelf-index { margin: 0; padding: 1rem 0 0; list-style: none; }
	.catalogue { margin-top: 0.85rem; }
	.catalogue > summary { display: flex; align-items: center; gap: 0.55rem; width: fit-content; color: var(--muted); font-size: 0.78rem; }
	.catalogue > summary::before { content: '+'; color: var(--accent); }
	.catalogue[open] > summary::before { content: '−'; }
	.catalogue-count { font-variant-numeric: tabular-nums; color: var(--muted); }
	.catalogue-open, .catalogue[open] .catalogue-closed { display: none; }
	.catalogue[open] .catalogue-open { display: inline; }
	.shelf-index li { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0.65rem; padding: 0.55rem 0; align-items: baseline; }
	.index-number { color: var(--muted); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
	.shelf-index a { font-size: 0.9rem; line-height: 1.7; text-decoration-thickness: 1px; }
	.index-author { display: block; margin-top: 0.15rem; color: var(--muted); font-size: 0.74rem; }
	.book { scroll-margin-top: 1.5rem; }
	.shelf-card { border: 1px solid var(--border); border-radius: 6px; background: color-mix(in srgb, var(--surface) 45%, var(--background)); }
	summary { list-style: none; cursor: pointer; }
	summary::-webkit-details-marker { display: none; }
	.shelf-summary { padding: 0.25rem 1.3rem 0.85rem; }
	.shelf-caption { display: flex; align-items: baseline; gap: 0.8rem; padding: 1.3rem 1.3rem 0; }
	.shelf-number { color: var(--muted); font-size: 0.65rem; letter-spacing: 0.08em; }
	.shelf-caption h2 { margin: 0; font-size: 1.05rem; }
	.shelf-count { margin-left: auto; color: var(--muted); font-size: 0.72rem; }
	.shelf-toggle { color: var(--muted); font-size: 1rem; }
	.shelf[open] > summary .shelf-toggle { transform: rotate(45deg); }
	.shelf-card :global(svg) { display: block; width: calc(100% - 2.6rem); height: auto; margin: 1rem 1.3rem 0; filter: drop-shadow(0 8px 5px rgb(0 0 0 / 0.07)); }
	.shelf-card :global(svg a) { cursor: pointer; }
	.shelf-card :global(svg a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
	.shelf-card :global(svg a g) { transition: transform 250ms ease; transform-box: fill-box; transform-origin: bottom; }
	.shelf-card :global(svg a:hover g), .shelf-card :global(svg a:focus-visible g) { transform: translateY(-4px); }
	.shelf-action { display: flex; justify-content: space-between; align-items: center; margin-top: 0.25rem; color: var(--accent); font-size: 0.73rem; }
	.when-open { display: none; }
	.shelf[open] > summary .when-open, .book[open] > summary .when-open { display: inline; }
	.shelf[open] > summary .when-closed, .book[open] > summary .when-closed { display: none; }
	.shelf-content { padding: 1.5rem; border-top: 1px solid var(--border); }
	.books { display: grid; gap: 1.25rem; }
	.book { min-width: 0; }
	.book-title { display: flex; gap: 0.7rem; align-items: baseline; font-size: 0.95rem; line-height: 1.7; font-weight: 600; }
	.book-note { margin-top: 1.25rem; padding: 1.1rem; border-left: 2px solid var(--accent); background: var(--background); overflow-wrap: anywhere; }
	.note-meta { color: var(--muted); font-size: 0.75rem; margin: 0 0 1rem; }
	.book-note .prose, .list-book .prose { font-size: 0.9rem; line-height: 1.85; }
	.source-link { display: inline-block; font-size: 0.86rem; margin-top: 0.75rem; }
	.source-domain { color: var(--muted); font-size: 0.7rem; margin: 0.35rem 0 0; }
	.list-topic { padding-top: 2rem; }
	.list-topic > h2 { font-size: 1.1rem; margin: 0 0 1.5rem; }
	.list-book + .list-book { margin-top: 2.5rem; }
	.list-book h3 { font-size: 1.2rem; margin: 0 0 0.6rem; }
	@media (max-width: 520px) { .shelf-summary { padding: 0.25rem 0.8rem 0.8rem; }.shelf-caption { padding: 1rem 0.8rem 0; gap: 0.55rem; }.shelf-card :global(svg) { width: calc(100% - 1.6rem); margin: 1rem 0.8rem 0; }.shelf-content { padding: 1.25rem; }.shelf-count { font-size: 0.65rem; } }
	@media (prefers-color-scheme: dark) { .library-page { --wood-light: #685e4d; --wood-front: #514839; --wood-mid: #484032; --wood-dark: #302c23; --wood-back: #282820; --wood-seam: #181b16; --metal: #9b8e6e; --book-cloth: #405d51; --book-highlight: #718777; --book-shadow: #223b2e; --book-label: #324c3f; --book-foil: #e0d7b6; } }
	@media (prefers-reduced-motion: reduce) { .shelf-card :global(svg a g) { transition: none; }.shelf-card :global(svg a:hover g), .shelf-card :global(svg a:focus-visible g) { transform: none; } }
</style>
