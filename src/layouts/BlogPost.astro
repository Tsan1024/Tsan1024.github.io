---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} · Tsan1024`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="article-heading">
					<p class="back"><a href="/">Blog</a><span aria-hidden="true"> / </span><span>Post</span></p>
					<h1>{title}</h1>
					<div class="metadata">
						<FormattedDate date={pubDate} />
						{updatedDate && <span>· Updated <FormattedDate date={updatedDate} /></span>}
					</div>
					{tags.length > 0 && <ul class="tag-list">{tags.map((tag) => <li>{tag}</li>)}</ul>}
				</header>
				<div class="prose"><slot /></div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-heading { padding: 3.5rem 0 2rem; border-bottom: 1px solid var(--border); }
	.article-heading h1 {
		margin: 1.25rem 0 0.75rem;
		font-size: clamp(1.65rem, 4vw, 2.2rem);
		line-height: 1.55;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.back, .metadata { color: var(--muted); font-size: 0.85rem; }
	.back { margin: 0; }
	.back a { color: var(--accent); text-decoration: none; }
	.metadata { margin-top: 1rem; }
	.tag-list { margin-top: 1rem; }
	.prose { padding-top: 2.5rem; }
	@media (max-width: 620px) { .article-heading { padding-top: 2.5rem; } }
</style>
